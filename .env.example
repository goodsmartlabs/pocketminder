# Where the SQLite database and uploaded attachments live (default: ./data)
POCKETMINDER_DATA_DIR=./data
# Optional: explicit database file path (overrides POCKETMINDER_DATA_DIR for the DB)
# DATABASE_PATH=./data/pocketminder.db
# Secret for GET /api/cron/notifications (Authorization: Bearer <secret>)
CRON_SECRET=change-me
