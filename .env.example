# Postgres connection string. On Supabase use the Transaction pooler URI (port 6543).
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
# Secret for GET /api/cron/notifications (Authorization: Bearer <secret>)
CRON_SECRET=change-me
# Session cookies are Secure (HTTPS-only) in production. Set to false only for plain-HTTP hosting.
# COOKIE_SECURE=false
